# U.S. Energy Information Administration API Key (https://www.eia.gov/opendata/register.php)
EIA_API_KEY=your_eia_api_key_here

# MotherDuck Token (Optional - Để trống nếu chạy DuckDB local)
MOTHERDUCK_TOKEN=

# Ngưỡng dừng an toàn MotherDuck Free Tier (GB / 10 GB gói Lite)
MOTHERDUCK_STOP_THRESHOLD_GB=9.0
